# Leave ANTHROPIC_API_KEY empty to run in demo mode (rule-based analyst, no data leaves the server).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

MAX_UPLOAD_MB=1024
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
MAX_CONCURRENT_ANALYSES=2
UPLOADS_PER_HOUR=10
# Set to 1 when hosted behind a reverse proxy so per-IP rate limits use X-Forwarded-For.
TRUST_PROXY=0
